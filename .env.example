# SwapSpot Environment Variables
# Copy this file to .env and fill in values for your environment.
# SwapSpot/settings.py loads .env automatically without external packages.

# ── Required for Production ──
# Django secret key (Render auto-generates this; keep a strong random value locally)
DJANGO_SECRET_KEY=change-me-to-a-long-random-value

# Debug mode: True=development, False=production
DJANGO_DEBUG=True

# Comma-separated allowed hosts (set in production to your domain)
# Production example: swapspot.masurii.dev,api.swapspot.masurii.dev,.onrender.com
DJANGO_ALLOWED_HOSTS=

# ── Database ──
# Render provides the DATABASE_URL connection string automatically via render.yaml.
# For local PostgreSQL testing, you may set a connection string if needed.
# DATABASE_URL=<your-connection-string>

# ── Optional ──
# Log level (DEBUG, INFO, WARNING, ERROR). Default: INFO in production.
# DJANGO_LOG_LEVEL=INFO

# Custom media root (Render uses a persistent disk)
# MEDIA_ROOT=/path/to/media
