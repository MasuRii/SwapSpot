# SwapSpot Local Environment Variables
# Copy this file to .env if you want to override the local defaults.
# SwapSpot/settings.py loads .env automatically without external packages.

# Optional local Django secret key. A development-only fallback is used when omitted.
DJANGO_SECRET_KEY=django-insecure-development-only-change-me

# Local debug mode. Keep True for normal code review and development.
DJANGO_DEBUG=True

# Optional comma-separated local hostnames if you need to test with a custom host.
DJANGO_ALLOWED_HOSTS=
