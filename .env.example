# SwapSpot Environment Variables
# Copy this file to .env and update the values for your environment.
# SwapSpot/settings.py loads .env automatically without external packages.

# Django secret key — required when DJANGO_DEBUG=False and recommended locally.
# Generate one at: https://djecrety.ir/
# Never deploy with the placeholder value below.
DJANGO_SECRET_KEY=your-secret-key-here

# Debug mode — defaults to True when omitted; set to False in production.
DJANGO_DEBUG=True

# Comma-separated list of allowed hostnames (e.g., "example.com,www.example.com").
# Required when DJANGO_DEBUG=False.
DJANGO_ALLOWED_HOSTS=

# Database URL — Django uses dj_database_url to parse this.
# When unset, the app falls back to a local SQLite database.
# Render provisions this automatically from the blueprint's database.
DATABASE_URL=
